{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "fs:allow-read-dir",
    "fs:allow-read-file",
    "fs:allow-read-text-file",
    "fs:allow-stat",
    "fs:allow-exists",
    "fs:allow-open",
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [
        { "path": "$APPLOCALDATA" },
        { "path": "$APPLOCALDATA/**" }
      ]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [
        { "path": "$APPLOCALDATA" },
        { "path": "$APPLOCALDATA/**" }
      ]
    },
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$LOCALDATA/Tyr/Saved/Demos" },
        { "path": "$LOCALDATA/Tyr/Saved/Demos/**" },
        { "path": "$APPLOCALDATA" },
        { "path": "$APPLOCALDATA/**" },

        { "path": "$HOME/**/steamapps/compatdata/2445260/**" },
        { "path": "/var/home/**/steamapps/compatdata/2445260/**" },
        { "path": "/run/media/**/steamapps/compatdata/2445260/**" },
        { "path": "/media/**/steamapps/compatdata/2445260/**" },
        { "path": "/mnt/**/steamapps/compatdata/2445260/**" }
      ]
    },
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://localhost:3000/**" },
        { "url": "http://127.0.0.1:3000/**" },
        { "url": "https://**" }
      ]
    }
  ]
}
